{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryCandidate",
  "type": "object",
  "required": ["candidate_id", "candidate_type", "content", "why", "confidence", "risk_level", "status"],
  "properties": {
    "candidate_id": { "type": "string" },
    "source_ref": { "type": ["string", "null"] },
    "candidate_type": { "enum": ["user", "feedback", "project", "reference", "not_memory"] },
    "target_agent": { "type": ["string", "null"] },
    "content": { "type": "string" },
    "why": { "type": "string" },
    "how_to_apply": { "type": ["string", "null"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "risk_level": { "enum": ["read_only", "review_required", "approval_required", "blocked"] },
    "status": { "enum": ["proposed", "reviewed", "committed", "rejected"] }
  }
}
